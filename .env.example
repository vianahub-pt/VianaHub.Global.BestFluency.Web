# URL pública definitiva do site (usada em canonical, hreflang, sitemap e JSON-LD).
# OBRIGATÓRIA em produção — o domínio definitivo ainda está pendente (docs/adr/0001).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Controla a indexação pelos motores de busca.
# Manter "false" até ao lançamento oficial da landing (evita indexar placeholders).
NEXT_PUBLIC_SITE_INDEXABLE=false

# Token do Cloudflare Web Analytics (opcional, sem cookies nem consentimento).
# Vazio = beacon desativado.
# Preencher apenas quando o domínio definitivo estiver publicado e o token
# real for fornecido pelo proprietário da conta Cloudflare (docs/analytics-kpis.md).
# NÃO inventar/colocar token fictício — o beacon com token inválido apenas
# falharia silenciosamente no navegador.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# Opcional — ativa o snippet gtag.js quando preenchido.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
